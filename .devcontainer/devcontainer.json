{
  "name": "Solace Developer Workshop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "onCreateCommand": "/bin/bash ${containerWorkspaceFolder}/util/tracker_extension.sh",
  "waitFor": "onCreateCommand",
  "postCreateCommand": "/bin/bash -i -c .devcontainer/configureEnv.sh",
  "postAttachCommand": "/bin/bash util/start.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8800": {
      "label": "Solace Agent Mesh",
      "onAutoForward": "openPreview"
    }
  },
  "hostRequirements": {
   "cpus": 4,
   "memory": "16gb",
   "storage": "32gb"
  },
  "remoteEnv": {
    "PATH": "/usr/local/go/bin:/home/vscode/go/bin:${containerEnv:PATH}"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "${containerWorkspaceFolder}/.devcontainer/extensions/workshop-tracker.vsix",
        "solace-tools.solace-try-me-vsc-extension",
        "barnim.markdown-code-copy-button"
      ],
       "settings": {
        "workshopTracker.webhookUrl": "https://2n3yr1kp0h.execute-api.us-east-2.amazonaws.com/prod/track",
        "files.autoSave": "afterDelay",
        "markdown.preview.openPreviewToSide": true,
        "workbench.editorAssociations": {
          "*.md": "vscode.markdown.preview.editor"
        }
      }
    }
  }
}
